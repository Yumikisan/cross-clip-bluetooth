<Window x:Class="ClipSyncWindows.Views.AccentColorsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ClipSyncWindows.Services"
        Width="360" MaxHeight="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=CardBackground}">

    <Window.Resources>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" BorderThickness="1"
                                BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground"
                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock x:Name="Heading" FontSize="13" FontWeight="SemiBold"
                   Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
        <TextBlock x:Name="Hint" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                   Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />

        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <ItemsControl x:Name="TypeList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontSize="12"
                                           Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
                                <TextBlock Text="{Binding Hex}" FontSize="10" Margin="0,1,0,0"
                                           Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource SwatchButton}"
                                    Background="{Binding Swatch}" Tag="{Binding}"
                                    Click="Swatch_Click" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ResetButton" Style="{StaticResource DialogButton}" Click="Reset_Click" />
            <Button x:Name="CloseButton" Style="{StaticResource DialogButton}" Click="Close_Click"
                    Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonColor}"
                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonForegroundColor}" />
        </StackPanel>
    </StackPanel>
</Window>
