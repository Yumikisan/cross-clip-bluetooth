<Window x:Class="ClipSyncWindows.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ClipSyncWindows.Services"
        Width="352" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=CardBackground}">

    <Window.Resources>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderThickness="1"
                                BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground"
                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock x:Name="Heading" FontSize="13" FontWeight="SemiBold"
                   Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />

        <UniformGrid x:Name="Swatches" Columns="8" Margin="0,12,0,0" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="#" VerticalAlignment="Center" Margin="0,0,6,0"
                       Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />

            <TextBox x:Name="HexBox" Grid.Column="1" Padding="6,4" FontFamily="Consolas"
                     TextChanged="HexBox_TextChanged" />

            <Border x:Name="Preview" Grid.Column="2" Width="40" Height="26" Margin="10,0,0,0"
                    CornerRadius="6"
                    BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}"
                    BorderThickness="1" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" Click="Cancel_Click" />
            <Button x:Name="OkButton" Style="{StaticResource DialogButton}" Click="Ok_Click"
                    Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonColor}"
                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonForegroundColor}" />
        </StackPanel>
    </StackPanel>
</Window>
