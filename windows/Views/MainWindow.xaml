<Window
    x:Class="ClipSyncWindows.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="clr-namespace:ClipSyncWindows.Services"
    xmlns:controls="clr-namespace:ClipSyncWindows.Controls"
    xmlns:converters="clr-namespace:ClipSyncWindows.Converters"
    xmlns:views="clr-namespace:ClipSyncWindows.Views"
    xmlns:behaviors="clr-namespace:ClipSyncWindows.Behaviors"
    Title="{x:Static services:AppInfo.Display}"
    Width="620"
    Height="740"
    MinWidth="520"
    MinHeight="600"
    Icon="pack://application:,,,/Assets/app.ico"
    Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=WindowBackground}"
    WindowStyle="None"
    AllowDrop="True"
    PreviewDragOver="Window_PreviewDragOver"
    PreviewDragLeave="Window_PreviewDragLeave"
    PreviewDrop="Window_PreviewDrop"
    StateChanged="Window_StateChanged"
    mc:Ignorable="d">

    <!-- Own caption bar so the pin toggle can sit next to minimize, the way the system
         buttons are laid out. CaptionHeight keeps dragging, double-click-to-maximize and
         Aero Snap working without any code behind. -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="34"
            ResizeBorderThickness="6"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="PinMenuItem" IsCheckable="True" Click="PinMenuItem_Click"
                      Header="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.alwaysOnTop]}" />
            <Separator />
            <MenuItem Click="ShowHotkeyHint_Click"
                      Header="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.openHotkey]}" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#6366F1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4F46E5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#9CA3AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShareButtonStyle"
            BasedOn="{StaticResource ModernButton}"
            TargetType="Button">
            <Setter Property="Background"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonColor}" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonForegroundColor}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                        Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonHoverColor}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RefreshButtonStyle" BasedOn="{StaticResource ModernButton}" TargetType="Button">
            <Setter Property="Background" Value="#4B5563" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3C4450" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StopButtonStyle" BasedOn="{StaticResource ModernButton}" TargetType="Button">
            <Setter Property="Background" Value="#EF4444" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButtonStyle" BasedOn="{StaticResource ModernButton}" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary action: same shape as ModernButton, drawn as an outlined tile. Ghost
             buttons look like plain text next to a filled one, which is what made the file page
             read as a mixed pile of links and buttons. -->
        <Style x:Key="OutlineButtonStyle" BasedOn="{StaticResource ModernButton}" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconToggleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
            <!-- Square and fixed: a stretched host must never turn the circle into a capsule. -->
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented tab pill -->
        <Style x:Key="TabPill" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- Center, never Stretch: the tab row is now as tall as the 36 px icon button on its
                 right, and a stretched pill would look swollen. -->
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                            Padding="13,6"
                            Background="Transparent"
                            BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonColor}" />
                                <Setter Property="Foreground"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonForegroundColor}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:AspectHeightConverter x:Key="AspectHeight" />

        <!-- Themed checkbox: the stock one renders a white box in the dark theme, which reads as
             "an empty input field" next to the device rows. Supports an optional label. -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="BoxBd" Width="17" Height="17" CornerRadius="4"
                                BorderThickness="1.2" Background="Transparent"
                                BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}">
                                <Grid>
                                    <Path x:Name="BoxTick" Data="M3.4,8.6 L6.8,12 L13.6,4.6"
                                        Stroke="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonForegroundColor}"
                                        StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="BoxLabel" Margin="8,0,0,0" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonColor}" />
                                <Setter TargetName="BoxBd" Property="BorderBrush"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonColor}" />
                                <Setter TargetName="BoxTick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBd" Property="BorderBrush"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonColor}" />
                            </Trigger>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="BoxLabel" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Square-ish icon button used inside a device row (gear, help dot). -->
        <Style x:Key="RowIconButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowIconBd" CornerRadius="12"
                            Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowIconBd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Destructive text link (forget this device). -->
        <Style x:Key="RowTextButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,4">
                            <TextBlock x:Name="RowTextLabel" FontSize="11.5"
                                Text="{TemplateBinding Content}"
                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=DangerText}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowTextLabel" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Collapsible section header: chevron + caller-supplied label and count. -->
        <Style x:Key="GroupHeaderToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="2,7,2,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="GroupChevron" Text="&#xE70D;"
                                    FontFamily="Segoe MDL2 Assets" FontSize="9"
                                    Margin="0,0,7,0" VerticalAlignment="Center"
                                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="GroupChevron" Property="Text" Value="&#xE76C;" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GroupChevron" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One device. Shared by the three sections below so the row never drifts apart. -->
        <DataTemplate x:Key="DeviceRowTemplate">
            <Border x:Name="DeviceRowBd" CornerRadius="8" Padding="6,7" Margin="0,0,0,2"
                Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Margin="3,0,11,0" VerticalAlignment="Center"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="16"
                        Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=IconBackground}">
                        <Grid>
                            <!-- The glyph geometry is authored on a 16x16 canvas, so it is wrapped
                                 in a fixed-size Viewbox: with Stretch="None" the Path took its own
                                 bounding box as its size, and a narrow phone outline ended up at a
                                 different offset than a wide monitor outline instead of both
                                 sitting on the badge's centre. -->
                            <Viewbox Width="15" Height="15" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Data="{Binding GlyphPath}"
                                        Stroke="{Binding Source={x:Static services:ThemeManager.Instance}, Path=IconForeground}"
                                        StrokeThickness="1.25"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>

                            <!-- Headsets / unidentified peripherals almost never run this app.
                                 The marker sits on the type badge itself, matching the phone, and
                                 explains itself on hover. -->
                            <Border Width="13" Height="13" CornerRadius="6.5" Margin="0,-1.5,-1.5,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=CardBackground}"
                                Cursor="Help"
                                ToolTipService.InitialShowDelay="150"
                                ToolTipService.ToolTip="{Binding Source={x:Static services:I18n.Instance}, Path=[dev.mayNotSupport]}"
                                Visibility="{Binding MayNotSupportSync, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="?" FontSize="8.5" FontWeight="SemiBold"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                            Text="{Binding Name}"
                            Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock FontSize="10" Opacity="0.8"
                                Text="{Binding KindText}"
                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                            <TextBlock FontSize="10" Margin="6,0,0,0" Opacity="0.55"
                                Text="{Binding AddressText}"
                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="10.5"
                        Text="{Binding StateText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Foreground"
                                            Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ConnectedText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Column="4" Margin="6,0,0,0" Style="{StaticResource RowIconButton}"
                        VerticalAlignment="Center" Click="DeviceSettings_Click" Tag="{Binding}"
                        ToolTip="{Binding Source={x:Static services:I18n.Instance}, Path=[dev.settings]}">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="DeviceRowBd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="DeviceRowBd" Property="Background"
                        Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Segmented pill: the device-settings counterpart of the Android choice chips.
             IsMouseOver is declared first so hovering a selected pill does not grey it out. -->
        <Style x:Key="SegPill" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                            MinWidth="30"
                            Padding="10,4"
                            Background="Transparent"
                            BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonColor}" />
                                <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonColor}" />
                                <Setter Property="Foreground"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonForegroundColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same pill look, but non-exclusive: used for multi-select filter chips. -->
        <!-- Small square icon button for the history header ("back to top"). Sized like the
             filter chips so the search box keeps its width. -->
        <Style x:Key="HistoryIconPill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12"
                            BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}"
                            BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TogglePill" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                            Padding="10,4"
                            Background="Transparent"
                            BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonColor}" />
                                <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonColor}" />
                                <Setter Property="Foreground"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonForegroundColor}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RadioPill" TargetType="RadioButton" BasedOn="{StaticResource TogglePill}" />

        <!-- Compact input used inside the filter panel. -->
        <Style x:Key="FilterInput" TargetType="TextBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}" />
            <Setter Property="Background"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListBackground}" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmoothScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
        </Style>

        <Style x:Key="SmoothScrollListView" TargetType="ListView">
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Slim scrollbars everywhere in this window (settings list included). -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="8" />
                    <Setter Property="MinHeight" Value="8" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBd" Background="#20000000" CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background" Value="#38000000" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background" Value="#50000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- Padding and margin follow the density setting (see HistoryAppearance). -->
            <Setter Property="Padding" Value="{DynamicResource HistoryItemPadding}" />
            <Setter Property="Margin" Value="{DynamicResource HistoryItemMargin}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="8"
                            SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemSelectedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <converters:FirstLetterConverter x:Key="FirstLetterConverter" />

        <!-- History layout: one entry per row, or two self-sizing columns. The card panel keeps
             each card at its natural height instead of padding every row to the tallest one. -->
        <ItemsPanelTemplate x:Key="HistoryListPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="HistoryCardPanel">
            <controls:TwoColumnPanel ColumnGap="{DynamicResource HistoryColumnGap}" RowGap="0" />
        </ItemsPanelTemplate>

        <!-- Caption bar buttons. Flat until hovered, like the system ones they sit next to;
             WindowChrome.IsHitTestVisibleInChrome is what makes them clickable at all inside
             the drag area. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground"
                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33808080" />
                                <Setter Property="Foreground"
                                        Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
        Margin="0"
        Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=CardBackground}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Caption bar. Everything except the buttons is the drag area, handled by
                 WindowChrome.CaptionHeight, so double-click-to-maximize and Aero Snap keep
                 working without a line of code. -->
            <Grid Grid.Row="0" Height="34"
                  Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=WindowBackground}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="pack://application:,,,/Assets/app.ico" Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                               Text="{x:Static services:AppInfo.Display}"
                               Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="PinButton" Style="{StaticResource CaptionButton}"
                            Content="&#xE718;" Click="PinButton_Click"
                            ToolTip="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.alwaysOnTop]}" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            Click="MinimizeButton_Click"
                            ToolTip="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.minimize]}" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            Click="MaximizeButton_Click"
                            ToolTip="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.maximize]}" />
                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                            Click="CloseButton_Click"
                            ToolTip="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.close]}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="14,10,14,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="19"
                            FontWeight="Bold"
                            Text="{Binding Source={x:Static services:I18n.Instance}, Path=[app.title]}"
                            Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=TitleGradient}" />
                        <!-- Standard Bluetooth glyph, same gradient as the wordmark so the pair
                             reads as one logo rather than text plus decoration. -->
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="22"
                            Text="&#xE702;"
                            Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=TitleGradient}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="LanguageButton"
                            Style="{StaticResource IconToggleButton}"
                            ToolTip="English / 中文"
                            Click="LanguageButton_Click">
                            <TextBlock x:Name="LanguageButtonText" FontSize="12" FontWeight="SemiBold"
                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[app.lang]}" />
                        </Button>
                        <Button x:Name="ThemeToggleButton"
                            Margin="6,0,0,0"
                            Style="{StaticResource IconToggleButton}"
                            ToolTip="Toggle Dark/Light Theme"
                            Click="ThemeToggleButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15">
                                <TextBlock.Text>
                                    <Binding Source="{x:Static services:ThemeManager.Instance}" Path="IsDarkTheme">
                                        <Binding.Converter>
                                            <converters:BoolToThemeIconConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                        <Button x:Name="SettingsButton"
                            Margin="6,0,0,0"
                            Style="{StaticResource IconToggleButton}"
                            ToolTip="Settings"
                            Click="SettingsButton_Click">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Tabs. MinHeight is fixed at the tallest thing that can appear on this row (the
                     36 px icon button in the history tools). Without it the row grows when the
                     tools become visible and every pill re-centres, which reads as the whole tab
                     strip hopping a few pixels as you switch pages. -->
                <Grid x:Name="TabRow" Grid.Row="1" Margin="0,0,0,10" MinHeight="36">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                        <RadioButton x:Name="DevicesTab" Style="{StaticResource TabPill}" IsChecked="True"
                            Content="{Binding Source={x:Static services:I18n.Instance}, Path=[tab.devices]}"
                            Checked="Tab_Checked" Tag="0" />
                        <RadioButton x:Name="HistoryTab" Style="{StaticResource TabPill}"
                            Content="{Binding Source={x:Static services:I18n.Instance}, Path=[tab.history]}"
                            Checked="Tab_Checked" Tag="1" />
                        <RadioButton x:Name="FilesTab" Style="{StaticResource TabPill}"
                            Content="{Binding Source={x:Static services:I18n.Instance}, Path=[tab.files]}"
                            Checked="Tab_Checked" Tag="2" />
                    </StackPanel>

                    <!-- History tools: count, destructive action and the layout switch share one
                         right-aligned row with the tabs, so the list can run all the way down.
                         The switch icon shows the mode a click will take you to. -->
                    <StackPanel x:Name="HistoryToolsPanel" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="HistoryCountText" VerticalAlignment="Center" Margin="0,0,10,0"
                            FontSize="11"
                            Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                            Text="" />

                        <Border x:Name="ClearHistoryButton" Background="Transparent" Cursor="Hand"
                            Margin="0,0,8,0" Height="30" Padding="12,0" CornerRadius="15"
                            BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=DangerText}"
                            BorderThickness="1" MouseLeftButtonUp="ClearHistoryLink_Click">
                            <TextBlock FontSize="11" VerticalAlignment="Center"
                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.clearHistory]}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                            Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=DangerText}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <Button x:Name="HistoryViewToggle"
                            Style="{StaticResource IconToggleButton}" Click="HistoryViewToggle_Click">
                            <Grid Width="16" Height="16">
                                <Path x:Name="ViewGridIcon"
                                    Data="M0,0 H6.4 V6.4 H0 Z M9.6,0 H16 V6.4 H9.6 Z M0,9.6 H6.4 V16 H0 Z M9.6,9.6 H16 V16 H9.6 Z"
                                    Fill="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                                <Path x:Name="ViewListIcon" Visibility="Collapsed"
                                    Data="M0,2.2 H16 V4.9 H0 Z M0,6.65 H16 V9.35 H0 Z M0,11.1 H16 V13.8 H0 Z"
                                    Fill="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Content -->
                <Grid Grid.Row="2">
                    <!-- ============ DEVICES ============ -->
                    <Grid x:Name="DevicesPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock VerticalAlignment="Center" FontWeight="Medium" FontSize="13"
                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"
                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.selectDevices]}" />
                            <TextBlock x:Name="DevicesCountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                        </Grid>

                        <Border Grid.Row="1"
                            Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListBackground}"
                            BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <ScrollViewer x:Name="DevicesScroll" Margin="6,4,2,4"
                                    Style="{StaticResource SmoothScrollViewer}">
                                    <StackPanel Margin="0,0,4,0">
                                        <!-- Devices the user marked "always trusted". Collapsible,
                                             open by default: these are the ones in daily use. -->
                                        <StackPanel x:Name="TrustedSection" Visibility="Collapsed">
                                            <ToggleButton x:Name="TrustedGroupToggle" IsChecked="True"
                                                Style="{StaticResource GroupHeaderToggle}"
                                                Click="DeviceGroupToggle_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="TrustedGroupLabel" FontSize="11" FontWeight="SemiBold"
                                                        Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <ItemsControl x:Name="TrustedDevicesList"
                                                ItemTemplate="{StaticResource DeviceRowTemplate}" />
                                        </StackPanel>

                                        <!-- Hidden devices: still selectable, just out of the way. -->
                                        <StackPanel x:Name="HiddenSection" Visibility="Collapsed">
                                            <ToggleButton x:Name="HiddenGroupToggle" IsChecked="False"
                                                Style="{StaticResource GroupHeaderToggle}"
                                                Click="DeviceGroupToggle_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="HiddenGroupLabel" FontSize="11" FontWeight="SemiBold"
                                                        Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <ItemsControl x:Name="HiddenDevicesList" Visibility="Collapsed"
                                                ItemTemplate="{StaticResource DeviceRowTemplate}" />
                                        </StackPanel>

                                        <!-- Ordinary devices: everything not trusted and not hidden,
                                             always at the bottom of the list. -->
                                        <ItemsControl x:Name="PrimaryDevicesList"
                                            ItemTemplate="{StaticResource DeviceRowTemplate}" />
                                    </StackPanel>
                                </ScrollViewer>

                                <TextBlock x:Name="DevicesEmptyText"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    FontSize="12" Visibility="Collapsed"
                                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                    Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.noPairedDevices]}" />
                            </Grid>
                        </Border>

                        <!-- ============ PER-DEVICE SETTINGS (overlay) ============
                             DataContext is the clicked row, so every switch writes straight through to
                             the persisted DevicePrefs and the list re-sorts itself. -->
                        <Grid x:Name="DeviceSettingsOverlay" Grid.RowSpan="3" Visibility="Collapsed"
                            Panel.ZIndex="30">
                            <Border Background="#55000000" MouseLeftButtonDown="DeviceSettingsDismiss_Click" />

                            <Border x:Name="DeviceSettingsCard" Width="368" HorizontalAlignment="Right"
                                Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=CardBackground}"
                                BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}"
                                BorderThickness="1" CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.25" Color="Black" />
                                </Border.Effect>
                                <StackPanel Margin="18,16,18,16">
                                    <Grid>
                                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Bold"
                                            Text="{Binding Source={x:Static services:I18n.Instance}, Path=[dev.settingsTitle]}"
                                            Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
                                        <Button HorizontalAlignment="Right" Style="{StaticResource RowIconButton}"
                                            Click="DeviceSettingsDismiss_Click">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                                        </Button>
                                    </Grid>

                                    <TextBlock x:Name="DeviceSettingsName" Margin="0,10,0,0" FontSize="14" FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
                                    <TextBlock x:Name="DeviceSettingsMeta" Margin="0,2,0,0" FontSize="10.5"
                                        Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />

                                    <!-- User-selected type: beats the OS misreporting the class. -->
                                    <TextBlock Margin="0,12,0,0" FontSize="12.5" FontWeight="SemiBold"
                                        Text="{Binding Source={x:Static services:I18n.Instance}, Path=[dev.kind]}"
                                        Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
                                    <TextBlock Margin="0,3,0,0" FontSize="10.5" TextWrapping="Wrap" MaxWidth="270"
                                        Text="{Binding Source={x:Static services:I18n.Instance}, Path=[dev.kindHint]}"
                                        Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                                    <StackPanel x:Name="DeviceKindPanel" Margin="0,8,0,0" Orientation="Horizontal">
                                        <RadioButton GroupName="DevKind" Tag="" Style="{StaticResource SegPill}"
                                            Content="{Binding Source={x:Static services:I18n.Instance}, Path=[dev.kindAuto]}"
                                            Click="DeviceKind_Click" />
                                        <RadioButton GroupName="DevKind" Tag="Phone" Style="{StaticResource SegPill}"
                                            Content="{Binding Source={x:Static services:I18n.Instance}, Path=[devkind.phone]}"
                                            Click="DeviceKind_Click" />
                                        <RadioButton GroupName="DevKind" Tag="Tablet" Style="{StaticResource SegPill}"
                                            Content="{Binding Source={x:Static services:I18n.Instance}, Path=[devkind.tablet]}"
                                            Click="DeviceKind_Click" />
                                        <RadioButton GroupName="DevKind" Tag="Computer" Style="{StaticResource SegPill}"
                                            Content="{Binding Source={x:Static services:I18n.Instance}, Path=[devkind.computer]}"
                                            Click="DeviceKind_Click" />
                                        <RadioButton GroupName="DevKind" Tag="Audio" Style="{StaticResource SegPill}"
                                            Content="{Binding Source={x:Static services:I18n.Instance}, Path=[devkind.audio]}"
                                            Click="DeviceKind_Click" />
                                        <RadioButton GroupName="DevKind" Tag="Other" Style="{StaticResource SegPill}"
                                            Content="{Binding Source={x:Static services:I18n.Instance}, Path=[devkind.other]}"
                                            Click="DeviceKind_Click" />
                                    </StackPanel>

                                    <Border Margin="0,14,0,0" Height="1"
                                        Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}" />

                                    <Grid Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[dev.alwaysTrusted]}"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
                                            <TextBlock Margin="0,3,0,0" FontSize="10.5" TextWrapping="Wrap" MaxWidth="270"
                                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[dev.alwaysTrustedHint]}"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                                        </StackPanel>
                                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Top"
                                            IsChecked="{Binding AlwaysTrusted, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[dev.autoReconnect]}"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
                                            <TextBlock Margin="0,3,0,0" FontSize="10.5" TextWrapping="Wrap" MaxWidth="270"
                                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[dev.autoReconnectHint]}"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                                        </StackPanel>
                                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Top"
                                            IsChecked="{Binding AutoReconnect, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[dev.fileSync]}"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
                                            <TextBlock Margin="0,3,0,0" FontSize="10.5" TextWrapping="Wrap" MaxWidth="270"
                                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[dev.fileSyncHint]}"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                                        </StackPanel>
                                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Top"
                                            IsChecked="{Binding FileSyncEnabled, Mode=TwoWay}" />
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[dev.hide]}"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
                                            <TextBlock Margin="0,3,0,0" FontSize="10.5" TextWrapping="Wrap" MaxWidth="270"
                                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[dev.hideHint]}"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                                        </StackPanel>
                                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Top"
                                            IsChecked="{Binding Hidden, Mode=TwoWay}" />
                                    </Grid>

                                    <Border Margin="0,16,0,0" Height="1"
                                        Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}" />

                                    <Grid Margin="0,14,0,0">
                                        <Button x:Name="DeviceForgetButton" HorizontalAlignment="Left"
                                            Style="{StaticResource RowTextButton}"
                                            Content="{Binding Source={x:Static services:I18n.Instance}, Path=[dev.forget]}"
                                            Click="DeviceForget_Click" />
                                        <Button HorizontalAlignment="Right" Height="30" Padding="16,0"
                                            Style="{StaticResource ModernButton}" Click="DeviceSettingsDismiss_Click"
                                            Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.done]}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button x:Name="RefreshDevicesButton" Margin="0,0,10,0"
                                Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.refresh]}"
                                Style="{StaticResource RefreshButtonStyle}" Click="RefreshDevicesButton_Click" />
                            <Button x:Name="StartServiceButton" Margin="0,0,10,0"
                                Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.start]}"
                                Style="{StaticResource ModernButton}" Click="StartServiceButton_Click" />
                            <Button x:Name="StopServiceButton" IsEnabled="False"
                                Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.stop]}"
                                Style="{StaticResource StopButtonStyle}" Click="StopServiceButton_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- ============ HISTORY ============ -->
                    <Grid x:Name="HistoryPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="8"
                                Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListBackground}"
                                BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}"
                                BorderThickness="1">
                                <Grid>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE721;"
                                        Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        IsHitTestVisible="False" Opacity="0.5"
                                        Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                                    <TextBox x:Name="SearchBox" Margin="0" Padding="30,6,10,6" BorderThickness="0"
                                        Background="Transparent"
                                        Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"
                                        TextChanged="SearchBox_TextChanged" />
                                    <TextBlock x:Name="SearchPlaceholder" Margin="31,0,10,0" IsHitTestVisible="False"
                                        VerticalAlignment="Center" FontSize="12"
                                        Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                        Opacity="0.6"
                                        Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.search]}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                <RadioButton x:Name="FilterAll" Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.filterAll]}"
                                    IsChecked="True" GroupName="HistFilter" Style="{StaticResource TabPill}" Checked="Filter_Checked" Tag="all" />
                                <RadioButton x:Name="FilterText" Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.filterText]}"
                                    GroupName="HistFilter" Style="{StaticResource TabPill}" Checked="Filter_Checked" Tag="text" />
                                <RadioButton x:Name="FilterFile" Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.filterFile]}"
                                    GroupName="HistFilter" Style="{StaticResource TabPill}" Checked="Filter_Checked" Tag="file" />
                            </StackPanel>

                            <!-- Advanced filter: same chip language as the Android bar -->
                            <ToggleButton x:Name="AdvancedFilterButton" Grid.Column="2" Margin="3,0,0,0"
                                Style="{StaticResource TogglePill}" Click="AdvancedFilterButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE71C;"
                                        VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock x:Name="AdvancedFilterLabel" FontSize="11" FontWeight="SemiBold"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <Button x:Name="HistoryTopButton" Grid.Column="3" Margin="4,0,0,0"
                                Style="{StaticResource HistoryIconPill}"
                                ToolTip="{Binding Source={x:Static services:I18n.Instance}, Path=[history_back_to_top]}"
                                Click="HistoryTopButton_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE74A;"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                        </Grid>

                        <Border Grid.Row="1"
                            Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListBackground}"
                            BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <ListView x:Name="HistoryListView" Margin="5" Style="{StaticResource SmoothScrollListView}"
                                    ItemContainerStyle="{StaticResource RowItemStyle}">
                                    <ListView.ItemTemplate>
                                            <DataTemplate>
                                            <!-- Whole row copies on click; the delete button swallows
                                                its own clicks so it stays an isolated action. -->
                                            <Grid Margin="2" Tag="{Binding Id}" MouseLeftButtonUp="HistoryCopy_Click"
                                                MouseLeftButtonDown="HistoryRow_MouseLeftButtonDown"
                                                Background="Transparent" Cursor="Hand">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- 4:3 preview for images. Cropped to fill
                                                     (UniformToFill) rather than stretched, so every
                                                     entry has the same preview height whatever the
                                                     photo's own shape; the metadata stays below
                                                     it instead of being overlaid on the picture. -->
                                                <Border Grid.Row="0" Margin="0,0,0,6"
                                                    CornerRadius="6" ClipToBounds="True"
                                                    Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                        Height="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource AspectHeight}, ConverterParameter=0.75}" />
                                                </Border>

                                                <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                    Width="{DynamicResource HistoryAccentWidth}"
                                                    Margin="0,0,8,0"
                                                    CornerRadius="2"
                                                    Background="{Binding AccentBrush}" />

                                                <!-- Files show a type tile where the 13px glyph
                                                     used to be: at that size every kind looked
                                                     like the same grey smudge, and an unknown
                                                     extension was indistinguishable from a
                                                     document. Images with a preview skip it.
                                                     The icon is the same Material geometry the
                                                     Android client draws; an unknown extension
                                                     replaces it with its own name. -->
                                                <Border Grid.Column="1" Width="40" Height="40"
                                                    Margin="0,2,11,2" CornerRadius="11"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding TypeBadgeBackground}"
                                                    Visibility="{Binding ShowTypeBadge, Converter={StaticResource BoolToVis}}">
                                                    <Grid>
                                                        <!-- A 24-unit canvas with no per-path
                                                             stretch: the folder is drawn as two
                                                             plates, and scaling each path on its
                                                             own would pull them apart. -->
                                                        <Viewbox Width="22" Height="22"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding ShowTypeGlyph, Converter={StaticResource BoolToVis}}">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Data="{Binding FolderBackGeometry}"
                                                                    Fill="{Binding AccentBrush}" Opacity="0.55" />
                                                                <Path Data="{Binding TypeGeometry}"
                                                                    Fill="{Binding AccentBrush}" />
                                                            </Canvas>
                                                        </Viewbox>
                                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                                            MaxWidth="31" MaxHeight="17"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding ShowExtensionTag, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock FontSize="10.5" FontWeight="SemiBold"
                                                                Foreground="{Binding AccentBrush}"
                                                                Text="{Binding ExtensionTag}" />
                                                        </Viewbox>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <Path Data="{Binding TextGlyphGeometry}" Fill="{Binding AccentBrush}"
                                                            Width="13" Height="13" Stretch="Uniform"
                                                            VerticalAlignment="Center" Margin="0,0,4,0"
                                                            Visibility="{Binding ShowTextGlyph, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock FontSize="{DynamicResource HistoryMetaFontSize}" FontWeight="SemiBold"
                                                            Foreground="{Binding AccentBrush}"
                                                            Text="{Binding FormatLabel}" />
                                                        <TextBlock FontSize="{DynamicResource HistoryMetaFontSize}" Margin="7,0,0,0" VerticalAlignment="Center"
                                                            Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                            Text="{Binding TimeText}" />
                                                    </StackPanel>
                                                    <TextBlock FontSize="{DynamicResource HistoryBodyFontSize}" TextWrapping="Wrap"
                                                        TextTrimming="CharacterEllipsis"
                                                        LineHeight="{Binding Source={x:Static services:HistoryViewOptions.Instance}, Path=PreviewLineHeight}"
                                                        MaxHeight="{Binding Source={x:Static services:HistoryViewOptions.Instance}, Path=PreviewMaxHeight}"
                                                        Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"
                                                        Text="{Binding Preview}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource HistoryMetaFontSize}"
                                                            VerticalAlignment="Center" Margin="0,0,4,0"
                                                            Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                            Text="{Binding DirectionGlyph}" />
                                                        <!-- Source device name: optional, because a
                                                             single-device setup repeats the same
                                                             string on every row. -->
                                                        <TextBlock FontSize="{DynamicResource HistoryMetaFontSize}"
                                                            Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                            Visibility="{Binding Source={x:Static services:HistoryViewOptions.Instance}, Path=ShowSourceDevice, Converter={StaticResource BoolToVis}}"
                                                            Text="{Binding Source}" />
                                                        <TextBlock FontSize="{DynamicResource HistoryMetaFontSize}" Margin="8,0,0,0"
                                                            Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                            Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"
                                                            Text="{Binding ItemCountText}" />
                                                        <TextBlock FontSize="{DynamicResource HistoryMetaFontSize}" Margin="8,0,0,0"
                                                            Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                            Text="{Binding SizeText}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                </Grid>

                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock x:Name="HistoryEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    FontSize="12" Opacity="0.6"
                                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                    Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.historyEmpty]}" />
                            </Grid>
                        </Border>

                        <!-- Count, Clear and the layout switch now live in the tab row above, so
                             the list owns the full height of the page and the bottom gap is gone. -->

                        <!-- ============ ADVANCED FILTER (overlay) ============
                             Kept inside the history page so it dims the list, not the whole window. -->
                        <Grid x:Name="FilterOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="20">
                            <Border Background="#4D000000" MouseLeftButtonDown="FilterOverlay_ScrimDown" />

                            <Border x:Name="FilterCard" Width="392" Margin="16" HorizontalAlignment="Right"
                                Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=CardBackground}"
                                BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}"
                                BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="16,12,8,4">
                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                            Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"
                                            Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.filterTitle]}" />
                                        <Button HorizontalAlignment="Right" Padding="7,4"
                                            Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Click="CloseFilterPanel_Click" />
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" Margin="16,0,10,0"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="0,0,4,0">
                                            <!-- text group -->
                                            <TextBlock FontSize="11" Opacity="0.7" Margin="0,4,0,4"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.filterTextGroup]}" />

                                            <WrapPanel x:Name="TextFormatPanel">
                                                <ToggleButton x:Name="FmtMarkdown" Style="{StaticResource TogglePill}" Tag="Markdown"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[fmt.markdown]}" />
                                                <ToggleButton x:Name="FmtCode" Style="{StaticResource TogglePill}" Tag="Code"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[fmt.code]}" />
                                                <ToggleButton x:Name="FmtUrl" Style="{StaticResource TogglePill}" Tag="Url"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[fmt.url]}" />
                                                <ToggleButton x:Name="FmtNumber" Style="{StaticResource TogglePill}" Tag="Number"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[fmt.number]}" />
                                                <ToggleButton x:Name="FmtLetter" Style="{StaticResource TogglePill}" Tag="Letter"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[fmt.letter]}" />
                                                <ToggleButton x:Name="FmtPlain" Style="{StaticResource TogglePill}" Tag="Plain"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[fmt.plain]}" />
                                            </WrapPanel>

                                            <TextBlock FontSize="11" Opacity="0.7" Margin="0,6,0,4"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.filterLength]}" />
                                            <WrapPanel x:Name="TextLengthModePanel">
                                                <RadioButton x:Name="TextLenAny" GroupName="TextLen" Tag="Any" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.modeAny]}" />
                                                <RadioButton x:Name="TextLenAtMost" GroupName="TextLen" Tag="AtMost" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.modeAtMost]}" />
                                                <RadioButton x:Name="TextLenAtLeast" GroupName="TextLen" Tag="AtLeast" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.modeAtLeast]}" />
                                                <RadioButton x:Name="TextLenBetween" GroupName="TextLen" Tag="Between" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.modeBetween]}" />
                                            </WrapPanel>
                                            <!-- The value row follows the chosen pill: nothing for "Any", one box
                                                 for "at most"/"at least", two boxes plus a dash for "between".
                                                 Leaving all four visible (as before) meant every mode looked
                                                 like "between" and hid which box actually applied. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=TextLenAny}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBox x:Name="TextMinBox" Width="70">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource FilterInput}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TextLenAtLeast}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TextLenBetween}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBlock Text="–" Margin="6,0" VerticalAlignment="Center"
                                                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TextLenBetween}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox x:Name="TextMaxBox" Width="70">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource FilterInput}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TextLenAtMost}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=TextLenBetween}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Opacity="0.7"
                                                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                    Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.chars]}" />
                                            </StackPanel>

                                            <Grid Margin="0,4,0,0">
                                                <TextBox x:Name="KeywordBox" Style="{StaticResource FilterInput}" />
                                                <TextBlock IsHitTestVisible="False" Margin="9,0,0,0"
                                                    VerticalAlignment="Center" FontSize="12" Opacity="0.45"
                                                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                    Text="{Binding Source={x:Static services:I18n.Instance}, Path=[filter.keywordPlaceholder]}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Value="">
                                                                    <DataTrigger.Binding>
                                                                        <Binding ElementName="KeywordBox" Path="Text" />
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <CheckBox x:Name="IgnoreCaseBox" Margin="0,6,0,0" FontSize="11" IsChecked="True"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"
                                                Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.filterIgnoreCase]}" />

                                            <TextBlock FontSize="11" Opacity="0.7" Margin="0,8,0,4"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.filterTime]}" />
                                            <WrapPanel x:Name="TextTimePanel">
                                                <RadioButton x:Name="TextTimeAny" GroupName="TextTime" Tag="Any" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.timeAny]}" />
                                                <RadioButton x:Name="TextTime5" GroupName="TextTime" Tag="Last5Min" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.time5min]}" />
                                                <RadioButton x:Name="TextTimeHour" GroupName="TextTime" Tag="LastHour" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.timeHour]}" />
                                                <RadioButton x:Name="TextTimeToday" GroupName="TextTime" Tag="Today" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.timeToday]}" />
                                                <RadioButton x:Name="TextTimeYesterday" GroupName="TextTime" Tag="Yesterday" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.timeYesterday]}" />
                                                <RadioButton x:Name="TextTimeCustom" GroupName="TextTime" Tag="Custom" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.timeCustom]}" />
                                            </WrapPanel>
                                            <!-- Same behaviour as the phone: the date field only appears
                                                 once "Pick a day" is chosen, so the panel does not ask for
                                                 a value the filter will ignore. -->
                                            <Grid Width="110" HorizontalAlignment="Left" Margin="0,0,0,4">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <Binding ElementName="TextTimeCustom" Path="IsChecked" />
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <TextBox x:Name="TextCustomDayBox"
                                                    Style="{StaticResource FilterInput}"
                                                    ToolTip="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.filterDayHint]}" />
                                                <TextBlock x:Name="TextCustomDayHint" IsHitTestVisible="False"
                                                    Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                                                    Opacity="0.45"
                                                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                    Text="{Binding Source={x:Static services:I18n.Instance}, Path=[filter.dayPlaceholder]}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Value="">
                                                                    <DataTrigger.Binding>
                                                                        <Binding ElementName="TextCustomDayBox" Path="Text" />
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <Border Height="1" Margin="0,8"
                                                Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}" />

                                            <!-- file group -->
                                            <TextBlock FontSize="11" Opacity="0.7" Margin="0,0,0,4"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.filterFileGroup]}" />

                                            <TextBox x:Name="FileExtBox" Width="110" HorizontalAlignment="Left"
                                                Style="{StaticResource FilterInput}" ToolTip=".png" />
                                            <TextBlock FontSize="10" Opacity="0.6" Margin="0,3,0,0" TextWrapping="Wrap"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.filterExtHint]}" />

                                            <TextBlock FontSize="11" Opacity="0.7" Margin="0,8,0,4"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.filterSize]}" />
                                            <WrapPanel x:Name="FileSizeModePanel">
                                                <RadioButton x:Name="FileSizeAny" GroupName="FileSize" Tag="Any" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.modeAny]}" />
                                                <RadioButton x:Name="FileSizeAtMost" GroupName="FileSize" Tag="AtMost" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.modeAtMost]}" />
                                                <RadioButton x:Name="FileSizeAtLeast" GroupName="FileSize" Tag="AtLeast" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.modeAtLeast]}" />
                                                <RadioButton x:Name="FileSizeBetween" GroupName="FileSize" Tag="Between" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.modeBetween]}" />
                                            </WrapPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=FileSizeAny}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBox x:Name="FileMinBox" Width="70">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource FilterInput}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=FileSizeAtLeast}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=FileSizeBetween}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBlock Text="–" Margin="6,0" VerticalAlignment="Center"
                                                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=FileSizeBetween}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox x:Name="FileMaxBox" Width="70">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource FilterInput}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=FileSizeAtMost}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=FileSizeBetween}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Opacity="0.7"
                                                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                    Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.unitKb]}" />
                                            </StackPanel>

                                            <TextBlock FontSize="11" Opacity="0.7" Margin="0,4,0,4"
                                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.filterTime]}" />
                                            <WrapPanel x:Name="FileTimePanel">
                                                <RadioButton x:Name="FileTimeAny" GroupName="FileTime" Tag="Any" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.timeAny]}" />
                                                <RadioButton x:Name="FileTime5" GroupName="FileTime" Tag="Last5Min" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.time5min]}" />
                                                <RadioButton x:Name="FileTimeHour" GroupName="FileTime" Tag="LastHour" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.timeHour]}" />
                                                <RadioButton x:Name="FileTimeToday" GroupName="FileTime" Tag="Today" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.timeToday]}" />
                                                <RadioButton x:Name="FileTimeYesterday" GroupName="FileTime" Tag="Yesterday" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.timeYesterday]}" />
                                                <RadioButton x:Name="FileTimeCustom" GroupName="FileTime" Tag="Custom" Style="{StaticResource RadioPill}"
                                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.timeCustom]}" />
                                            </WrapPanel>
                                            <Grid Width="110" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <Binding ElementName="FileTimeCustom" Path="IsChecked" />
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <TextBox x:Name="FileCustomDayBox"
                                                    Style="{StaticResource FilterInput}"
                                                    ToolTip="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.filterDayHint]}" />
                                                <TextBlock IsHitTestVisible="False" Margin="9,0,0,0"
                                                    VerticalAlignment="Center" FontSize="12" Opacity="0.45"
                                                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                    Text="{Binding Source={x:Static services:I18n.Instance}, Path=[filter.dayPlaceholder]}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Value="">
                                                                    <DataTrigger.Binding>
                                                                        <Binding ElementName="FileCustomDayBox" Path="Text" />
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Grid Grid.Row="2" Margin="16,8,16,14">
                                        <Button HorizontalAlignment="Left" Padding="12,6"
                                            Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.filterReset]}"
                                            Style="{StaticResource GhostButtonStyle}" Click="FilterReset_Click" />
                                        <Button HorizontalAlignment="Right" Padding="16,7"
                                            Content="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.filterApply]}"
                                            Style="{StaticResource ShareButtonStyle}" Click="FilterApply_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ============ FILES ============ -->
                    <Grid x:Name="FilesPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="16" CornerRadius="10"
                            Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListBackground}"
                            BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}"
                            BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" FontSize="13"
                                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"
                                    Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.transfer]}" />
                                <TextBlock x:Name="FileLimitText" Margin="0,6,0,0" FontSize="12"
                                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                    Text="" />
                                <TextBlock x:Name="FileQualityText" Margin="0,4,0,0" FontSize="12"
                                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                    Text="" />
                            </StackPanel>
                        </Border>

                        <!-- Every action is the same width and the same height: pick → send is one
                             flow (so the two share a column pair), everything else is a full-width
                             secondary tile. Left-aligned buttons of three different styles were
                             what made this page look unfinished. -->
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock FontSize="11" Margin="2,0,0,6"
                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.sendFileSection]}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="PickFileButton" Grid.Column="0"
                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.pickFile]}"
                                    Style="{StaticResource ModernButton}" Click="PickFile_Click" />

                                <Button x:Name="SendFileButton" Grid.Column="2" IsEnabled="False"
                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.sendFile]}"
                                    Style="{StaticResource ShareButtonStyle}" Click="SendFile_Click" />
                            </Grid>

                            <TextBlock x:Name="SelectedFileText" Margin="2,8,2,0" FontSize="12"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                Text="" />

                            <ProgressBar x:Name="TransferProgressBar" Height="6" Margin="0,8,0,0"
                                Minimum="0" Maximum="1" Value="0" Visibility="Collapsed" />

                            <!-- Speed and time left matter more than the percentage once a file
                                 takes minutes; the cancel button is the only way out of one. -->
                            <Grid Margin="0,6,0,0">
                                <TextBlock x:Name="TransferSpeedText" FontSize="11" VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" Text=""
                                    Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                                <Button x:Name="CancelTransferButton" HorizontalAlignment="Right"
                                    Visibility="Collapsed" Click="CancelTransfer_Click"
                                    Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.cancel]}"
                                    Style="{StaticResource GhostButtonStyle}" Padding="10,3" FontSize="11" />
                            </Grid>

                            <Button x:Name="SendFolderButton" Margin="0,10,0,0" IsEnabled="False"
                                Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.sendFolder]}"
                                Style="{StaticResource OutlineButtonStyle}" Click="SendFolder_Click" />

                            <Button x:Name="OpenDownloadFolderButton" Margin="0,8,0,0"
                                Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.openFolder]}"
                                Style="{StaticResource OutlineButtonStyle}" Click="OpenDownloadFolder_Click" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Margin="2,0,2,0" TextWrapping="Wrap"
                            VerticalAlignment="Bottom" FontSize="11" Opacity="0.65"
                            Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                            Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.about]}" />
                    </Grid>

                    <!-- ============ SETTINGS (full page) ============ -->
                    <views:SettingsView x:Name="SettingsPanel" Visibility="Collapsed" />
                </Grid>

                <!-- Status bar -->
                <Border Grid.Row="3" Padding="15,12" Margin="0,14,0,0"
                    Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=StatusBarBackground}"
                    CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                Fill="{Binding Source={x:Static services:ThemeManager.Instance}, Path=StatusBarEllipseColor}" />
                            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" FontWeight="Medium"
                                FontSize="12" TextTrimming="CharacterEllipsis"
                                Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=IconForeground}"
                                Text="{Binding Source={x:Static services:I18n.Instance}, Path=[status.ready]}" />
                        </StackPanel>

                        <Button x:Name="ShareButton" Grid.Column="1" IsEnabled="False"
                            Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.share]}"
                            Style="{StaticResource ShareButtonStyle}" Click="ShareButton_Click" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Drop target hint: only visible while a file is dragged over the window -->
            <Border x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False"
                Background="#D9101115">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="42" HorizontalAlignment="Center"
                        Foreground="White" Text="&#xE896;" />
                    <TextBlock Margin="0,12,0,0" FontSize="14" TextAlignment="Center"
                        MaxWidth="320" TextWrapping="Wrap" Foreground="White"
                        Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.dropHint]}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
