                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.support]}" />
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.supportHint]}" />

                            <TextBlock Margin="0,14,0,2" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.faq]}" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.faqHint]}" />
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[faq.q1]}" />
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[faq.a1]}" />
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[faq.q2]}" />
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[faq.a2]}" />
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[faq.q3]}" />
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[faq.a3]}" />
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[faq.q4]}" />
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[faq.a4]}" />
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[faq.q5]}" />
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[faq.a5]}" />
                            </StackPanel>
                            <TextBlock Margin="0,16,0,2" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.feedback]}" />
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.feedbackHint]}" />

                            <Grid Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource RowText}"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.feedbackKind]}" />
                                <ComboBox x:Name="FeedbackKindBox" HorizontalAlignment="Right" Width="150"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="{Binding Source={x:Static services:I18n.Instance}, Path=[fb.kind.bug]}" />
                                    <ComboBoxItem Content="{Binding Source={x:Static services:I18n.Instance}, Path=[fb.kind.ui]}" />
                                    <ComboBoxItem Content="{Binding Source={x:Static services:I18n.Instance}, Path=[fb.kind.sync]}" />
                                    <ComboBoxItem Content="{Binding Source={x:Static services:I18n.Instance}, Path=[fb.kind.idea]}" />
                                </ComboBox>
                            </Grid>

                            <TextBox x:Name="FeedbackDetailBox" Margin="0,8,0,0" MinHeight="64"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="{Binding Source={x:Static services:I18n.Instance}, Path=[fb.detail.placeholder]}" />

                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource SvcButton}" Margin="0,0,8,8"
                                        Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.copyReport]}"
                                        Click="CopyReport_Click" />
                                <Button Style="{StaticResource SvcButton}" Margin="0,0,8,8"
                                        Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.exportLogs]}"
                                        Click="ExportLogs_Click" />
                                <Button Style="{StaticResource SvcButton}" Margin="0,0,8,8"
                                        Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.reportBug]}"
                                        Click="OpenIssues_Click" />
                                <Button Style="{StaticResource SvcButton}" Margin="0,0,8,8"
                                        Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.helpDoc]}"
                                        Click="OpenHelpDoc_Click" />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.logsHint]}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.aboutTitle]}" />
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[about.blurb]}" />
                            <TextBlock Margin="0,8,0,0" FontSize="11" Opacity="0.7"
                                       Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                       Text="{Binding AppVersion, StringFormat='CBB {0}'}" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource SvcButton}" Margin="0,0,8,8"
                                        Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.devHome]}"
                                        Click="OpenDevHome_Click" />
                                <Button Style="{StaticResource SvcButton}" Margin="0,0,8,8"
                                        Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.forkHome]}"
                                        Click="OpenForkHome_Click" />
                            </WrapPanel>
                            <!-- Two sponsor buttons, never one: the upstream author and this fork are
                                 different people, and the label has to make that obvious. -->
                            <WrapPanel Margin="0,2,0,0">
                                <Button Style="{StaticResource SvcButton}" Margin="0,0,8,8"
                                        Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.sponsorUpstream]}"
                                        Click="OpenUpstreamSponsor_Click" />
                                <Button Style="{StaticResource SvcButton}" Margin="0,0,8,8"
                                        Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.sponsorFork]}"
                                        Click="OpenForkSponsor_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>


                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.6"
                           Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                           Text="{Binding AppVersion, StringFormat='CBB {0} · Bluetooth only'}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
