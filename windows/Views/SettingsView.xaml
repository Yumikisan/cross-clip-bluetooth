<UserControl x:Class="ClipSyncWindows.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:ClipSyncWindows.ViewModels"
             xmlns:services="clr-namespace:ClipSyncWindows.Services"
             xmlns:converters="clr-namespace:ClipSyncWindows.Converters"
             mc:Ignorable="d"
             d:DesignHeight="740" d:DesignWidth="380">

    <UserControl.DataContext>
        <viewModels:SettingsViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="CleanButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B91C1C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One card per settings group: same visual language as the Android settings page
             (rounded surface, title inside, hint under the title). -->
        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12,14,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=CardBackground}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>

        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
        </Style>

        <!-- Segmented pill: the settings counterpart of the Android choice chips.
             IsMouseOver is declared first so hovering a selected pill does not grey it out. -->
        <Style x:Key="SegPill" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                            MinWidth="30"
                            Padding="10,4"
                            Background="Transparent"
                            BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonColor}" />
                                <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonColor}" />
                                <Setter Property="Foreground"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonForegroundColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
        </Style>

        <!-- Text-only action: used where a full button would outweigh the row it sits in. -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <!-- ShareButtonColor is a *fill* (very light in the light theme); using it as text
                 made the link nearly invisible. The foreground of that same button is the
                 readable version of the accent. -->
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ShareButtonForegroundColor}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"
                                   VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drop-down row: WPF's default item container paints a light system highlight, which
             leaves light text on light grey in the dark theme. -->
        <Style x:Key="FieldComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd" Background="Transparent" CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemSelectedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FieldComboItem}" />
            <Setter Property="Background"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=FieldBackground}" />
            <Setter Property="BorderBrush"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBd" CornerRadius="6" BorderThickness="1"
                                            Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=FieldBackground}"
                                            BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}">
                                            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="0,1,10,0" Data="M0,0 L3.5,4 L7,0"
                                                Stroke="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                                StrokeThickness="1.4" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBd" Property="BorderBrush"
                                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemSelectedBorder}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False" VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="9,0,22,0"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />

                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                                AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False"
                                IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border MinWidth="{TemplateBinding ActualWidth}" Margin="0,4,0,0" Padding="4"
                                    CornerRadius="6" BorderThickness="1" MaxHeight="320"
                                    Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=FieldPopupBackground}"
                                    BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=FieldBackground}" />
            <Setter Property="BorderBrush"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
            <Setter Property="CaretBrush"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
            <Setter Property="SelectionBrush"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemSelectedBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBd" CornerRadius="6" BorderThickness="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBd" Property="BorderBrush"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemSelectedBorder}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The passphrase field: same chrome as the other inputs, characters masked. -->
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=FieldBackground}" />
            <Setter Property="BorderBrush"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
            <Setter Property="CaretBrush"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PskBd" CornerRadius="6" BorderThickness="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PskBd" Property="BorderBrush"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemSelectedBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ordinary secondary action (Browse…, Clear hotkey): themed like the fields next to it. -->
        <Style x:Key="SvcButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SvcBd" CornerRadius="6" BorderThickness="1"
                            Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=FieldBackground}"
                            BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SvcBd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SvcBd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemSelectedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row-level delete: a bare glyph that only shows its danger tint on hover, so the
             storage table stays calm instead of being a wall of red buttons. -->
        <Style x:Key="RowDeleteButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DelBd" CornerRadius="5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DelBd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DelBd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemSelectedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The − / + stepper: the stock button chrome is light and clashes with both themes. -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground"
                Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StepBd" CornerRadius="6" BorderThickness="1"
                            Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=FieldBackground}"
                            BorderBrush="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StepBd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StepBd" Property="Background"
                                    Value="{Binding Source={x:Static services:ThemeManager.Instance}, Path=ListItemSelectedBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{Binding Source={x:Static services:ThemeManager.Instance}, Path=CardBackground}">
        <Grid Margin="20,18,4,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.settings]}"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=PrimaryText}" />
            </Grid>

            <!-- The scrollbar hugs the window edge, so the content needs its own right inset,
                 otherwise fields and stepper buttons sit right on top of the thumb. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                          Padding="0,0,16,0">
                <StackPanel>
                    <!-- Storage management -->
                    <Border Style="{StaticResource GroupCard}">
                        <StackPanel>

                    <TextBlock Style="{StaticResource SectionTitle}"
                               Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.storage]}" />

                    <Grid Margin="0,2" Visibility="{Binding HasStorage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- header row (same column widths as data rows). The type / count /
                             size columns are deliberately narrow and packed together: spread
                             across the full width the numbers drifted far from their labels. -->
                        <Grid Grid.Row="0" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowText}" FontSize="11" Opacity="0.65"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[col.type]}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowText}" FontSize="11" Opacity="0.65"
                                       TextAlignment="Right"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[col.count]}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource RowText}" FontSize="11" Opacity="0.65"
                                       TextAlignment="Right"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[col.size]}" />
                        </Grid>

                        <!-- data rows with hairline separators -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding StorageStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="118" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource RowText}"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource RowText}"
                                                       TextAlignment="Right" Text="{Binding Count}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource RowText}"
                                                       TextAlignment="Right" Text="{Binding SizeText}" />
                                            <!-- One type at a time: the whole row's records and their
                                                 stored file go, after an explicit confirmation. -->
                                            <Button Grid.Column="4" Style="{StaticResource RowDeleteButton}"
                                                    Tag="{Binding}" Click="StorageDeleteKind_Click"
                                                    ToolTip="{Binding DeleteHint}">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                                            </Button>
                                        </Grid>
                                        <Rectangle Grid.Row="1" Height="1" Opacity="0.35"
                                                   Fill="{Binding Source={x:Static services:ThemeManager.Instance}, Path=BorderBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- total -->
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="12" Opacity="0.7"
                                       Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.storageTotal]}" />
                            <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                       TextAlignment="Right" Text="{Binding StorageTotalText}" />
                        </Grid>
                    </Grid>

                    <TextBlock Margin="0,2" FontSize="12" Opacity="0.6"
                               Visibility="{Binding HasStorage, Converter={StaticResource InverseBoolToVis}}"
                               Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                               Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.storageEmpty]}" />

                    <Button Margin="0,10,0,0" HorizontalAlignment="Left"
                            Content="{Binding Source={x:Static services:I18n.Instance}, Path=[btn.cleanNow]}"
                            Style="{StaticResource CleanButtonStyle}" Click="CleanNow_Click" />

                    <Grid Margin="0,12,0,2">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowText}"
                                       Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.expireClean]}" />
                        </StackPanel>
                        <CheckBox HorizontalAlignment="Right" IsChecked="{Binding AutoCleanExpired, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,8,0,2">
                        <TextBlock Style="{StaticResource RowText}"
                                   Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.imageRetention]}" />
                        <ComboBox HorizontalAlignment="Right" Width="110"
                                  ItemsSource="{Binding RetentionChoices}"
                                  SelectedValue="{Binding ImageRetentionDays, Mode=TwoWay}"
                                  SelectedValuePath="Days" />
                    </Grid>

                    <Grid Margin="0,8,0,2">
                        <TextBlock Style="{StaticResource RowText}"
                                   Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.fileRetention]}" />
                        <ComboBox HorizontalAlignment="Right" Width="110"
                                  ItemsSource="{Binding RetentionChoices}"
                                  SelectedValue="{Binding FileRetentionDays, Mode=TwoWay}"
                                  SelectedValuePath="Days" />
                    </Grid>

                    <Grid Margin="0,12,0,2">
                        <TextBlock Style="{StaticResource RowText}"
                                   Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.thresholdClean]}" />
                        <CheckBox HorizontalAlignment="Right" IsChecked="{Binding ThresholdCleanupEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,8,0,2">
                        <TextBlock Style="{StaticResource RowText}"
                                   Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.maxStorage]}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource StepButton}" Content="−" Click="MaxStorageMinus_Click" />
                            <TextBox Width="70" Margin="6,0" Text="{Binding MaxStorageMb, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     HorizontalContentAlignment="Center" />
                            <Button Style="{StaticResource StepButton}" Content="+" Click="MaxStoragePlus_Click" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" Opacity="0.6" Text="MB"
                                       Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}" />
                        </StackPanel>
                    </Grid>

