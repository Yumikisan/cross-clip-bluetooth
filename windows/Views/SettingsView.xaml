                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SecurityMode, Mode=TwoWay}">
                            <!-- ItemTemplate instead of DisplayMemberPath: the latter is a plain
                                 property path with no change notification, so the labels would
                                 stay in the old language after a switch. -->
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                               Text="{Binding SecurityModeHint}" />
