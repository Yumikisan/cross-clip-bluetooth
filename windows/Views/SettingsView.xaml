                                <PasswordBox x:Name="PskBox" KeyDown="PskBox_KeyDown"
                                             PasswordChanged="PskBox_PasswordChanged" />
                                <TextBox x:Name="PskBoxPlain" Visibility="Collapsed"
                                         KeyDown="PskBox_KeyDown" VerticalContentAlignment="Center"
                                         TextChanged="PskBoxPlain_TextChanged" />
                                <!-- Visibility is driven from code, not a trigger on
                                     PasswordBox.Password: that is a plain CLR property, so a
                                     binding to it never updates and the hint stayed on top of the
                                     masked dots. -->
                                <TextBlock x:Name="PskPlaceholder" IsHitTestVisible="False" Margin="9,0,0,0"
                                           VerticalAlignment="Center" FontSize="12" Opacity="0.45"
                                           Foreground="{Binding Source={x:Static services:ThemeManager.Instance}, Path=SecondaryText}"
                                           Text="{Binding Source={x:Static services:I18n.Instance}, Path=[psk.placeholder]}" />
