                               Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.secModeHint]}" />

                    <StackPanel Margin="0,10,0,2">
                        <TextBlock Style="{StaticResource RowText}"
                                   Text="{Binding Source={x:Static services:I18n.Instance}, Path=[lbl.psk]}" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="{Binding PskSummary}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <!-- Masked by default; the eye swaps in a plain TextBox so the key can be
                                 checked character by character before it is saved. -->
